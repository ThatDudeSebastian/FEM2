    Variables=["Tensile Yield Strength"],
    Values=[["600 [MPa]"]])
matlProp6 = matl1.CreateProperty(
    Name="Kinematic Hardening",
    Definition="Bilinear",
    Qualifiers={"Definition": "Bilinear", "Behavior": ""})
matlProp6.SetData(
    Index=-1,
